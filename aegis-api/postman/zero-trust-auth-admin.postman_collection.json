{
    "info": {
        "name": "Zero Trust Auth Admin Workflow",
        "_postman_id": "9d9c1e9f-zt-admin-workflow",
        "description": "Functional + admin/security dashboard workflow for Axum Zero Trust Auth System",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
